generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  USER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum SellerTradeCapability {
  RETAIL
  WHOLESALE
  IMPORTER
  EXPORTER
  MANUFACTURER
  DISTRIBUTOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CategoryType {
  PRODUCT
  SERVICE
  CONTENT
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderType {
  RETAIL
  WHOLESALE
  SOURCING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum SellerOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

enum PaymentProvider {
  PAYSTACK
}

enum PaymentType {
  ORDER_PAYMENT
}

enum FulfillmentType {
  LOCAL
  IMPORT
  PREORDER
  DIGITAL
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  RESERVE
  RELEASE
  ADJUSTMENT
  SALE
  RETURN
  RESTOCK
}

enum AddressType {
  HOME
  BUSINESS
  DELIVERY
  OTHER
}

enum SourcingRequestStatus {
  OPEN
  NEGOTIATING
  QUOTED
  ACCEPTED
  FULFILLED
  CANCELLED
  EXPIRED
}

enum SourcingResponseStatus {
  SUBMITTED
  NEGOTIATING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum SourcingMessageType {
  MESSAGE
  PRICE_PROPOSAL
  COUNTER_OFFER
  SYSTEM
}

enum TradePaymentTerm {
  PREPAID
  PARTIAL
  NET_7
  NET_14
  NET_30
}

enum ShippingMethod {
  LOCAL
  IMPORT
  SEA
  AIR
  DIGITAL
}

enum MarketActivityType {
  // Discovery
  PRODUCT_VIEW
  PRODUCT_SEARCH
  CATEGORY_VIEW
  SELLER_VIEW

  // Intent
  PRODUCT_FAVORITED
  PRODUCT_UNFAVORITED
  PRODUCT_ADDED_TO_CART
  PRODUCT_REMOVED_FROM_CART

  // Sourcing
  SOURCING_REQUEST_CREATED
  SOURCING_RESPONSE_SUBMITTED

  // Commerce
  ORDER_CREATED
  ORDER_CANCELLED
  ORDER_COMPLETED

  // Payment
  PAYMENT_COMPLETED
  PAYMENT_FAILED

  // Fulfillment
  FULFILLMENT_CREATED
  FULFILLMENT_SHIPPED
  FULFILLMENT_DELIVERED

  // Inventory
  INVENTORY_STOCKED_IN
  INVENTORY_ADJUSTED
  INVENTORY_RESERVED
  INVENTORY_RELEASED
  INVENTORY_COMMITTED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MarketSignalType {
  PRODUCT_DEMAND
  CATEGORY_DEMAND
  GEOGRAPHIC_DEMAND
  SUPPLY_DEMAND_OPPORTUNITY
}

enum MarketSignalEntityType {
  PRODUCT
  CATEGORY
  LOCATION
}

enum MarketIntelligenceType {
  TREND
  OPPORTUNITY
  RISK
  DEMAND_SPIKE
  SUPPLY_GAP
  GEOGRAPHIC_SHIFT
  CATEGORY_GROWTH
  MARKET_STRENGTH
}

enum MarketIntelligenceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MarketIntelligenceEntityType {
  PRODUCT
  CATEGORY
  LOCATION
}

model MarketIntelligence {
  id String @id @default(cuid())

  intelligenceType MarketIntelligenceType
  entityType       MarketIntelligenceEntityType
  entityId         String

  severity MarketIntelligenceSeverity

  confidence Decimal?

  title   String
  summary String

  metrics  Json
  evidence Json?

  windowStart DateTime
  windowEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  aiInterpretation MarketIntelligenceInterpretation?

  @@index([intelligenceType, entityType, entityId])
  @@index([severity, createdAt])
  @@index([windowStart, windowEnd])
  @@index([entityId])
}

model MarketIntelligenceInterpretation {
  id String @id @default(cuid())

  intelligenceId String @unique

  model String
  promptVersion String

  headline String
  explanation String
  marketImplication String
  recommendedAction String
  riskNote String
  confidenceExplanation String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intelligence MarketIntelligence @relation(
    fields: [intelligenceId],
    references: [id],
    onDelete: Cascade
  )

  @@index([createdAt])
}


// ============================================================
// USER & AUTHENTICATION
// ============================================================

model User {
  id       String     @id @default(cuid())
  fullName String
  email    String     @unique
  phone    String?    @unique
  password String
  role     UserRole   @default(USER)
  status   UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens          RefreshToken[]
  addresses              Address[]
  sellerProfile          SellerProfile?
  carts                  Cart[]
  orders                 Order[]
  reviews                Review[]
  wishlists              Wishlist[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  auditLogs              AuditLog[]

  sourcingRequests  SourcingRequest[]
  sourcingResponses SourcingResponse[]
  sourcingMessages  SourcingMessage[]
  reviewResponses   ReviewResponse[]

  marketActivities MarketActivity[]

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// LOCATION
// ============================================================

model Country {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states State[]

  addresses        Address[]
  sellers          SellerProfile[]
  locations        BusinessLocation[]
  warehouses       Warehouse[]
  orders           Order[]
  sourcingRequests SourcingRequest[]

  marketActivities MarketActivity[]
  marketSignals    MarketSignal[]
}

model State {
  id        String @id @default(cuid())
  countryId String
  name      String
  code      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  lgas Lga[]

  addresses        Address[]
  sellers          SellerProfile[]
  locations        BusinessLocation[]
  warehouses       Warehouse[]
  orders           Order[]
  sourcingRequests SourcingRequest[]

  marketActivities MarketActivity[]
  marketSignals    MarketSignal[]

  @@unique([countryId, code])
  @@unique([countryId, name])
  @@index([countryId])
}

model Lga {
  id      String @id @default(cuid())
  stateId String
  name    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  cities City[]

  addresses        Address[]
  sellers          SellerProfile[]
  locations        BusinessLocation[]
  warehouses       Warehouse[]
  orders           Order[]
  sourcingRequests SourcingRequest[]

  marketActivities MarketActivity[]
  marketSignals    MarketSignal[]

  @@unique([stateId, name])
  @@index([stateId])
}

model City {
  id    String @id @default(cuid())
  lgaId String
  name  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lga Lga @relation(fields: [lgaId], references: [id], onDelete: Cascade)

  addresses        Address[]
  locations        BusinessLocation[]
  warehouses       Warehouse[]
  orders           Order[]
  sourcingRequests SourcingRequest[]

  marketActivities MarketActivity[]
  marketSignals    MarketSignal[]

  @@unique([lgaId, name])
  @@index([lgaId])
}

// ============================================================
// USER ADDRESSES
// ============================================================

model Address {
  id String @id @default(cuid())

  userId String

  type        AddressType @default(DELIVERY)
  label       String?
  fullName    String
  phone       String
  addressLine String

  countryId String?
  stateId   String?
  lgaId     String?
  cityId    String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  country Country? @relation(fields: [countryId], references: [id])
  state   State?   @relation(fields: [stateId], references: [id])
  lga     Lga?     @relation(fields: [lgaId], references: [id])
  city    City?    @relation(fields: [cityId], references: [id])

  @@index([userId])
  @@index([stateId])
  @@index([lgaId])
  @@index([cityId])
}

// ============================================================
// SELLER
// ============================================================

model SellerProfile {
  id String @id @default(cuid())

  userId String @unique

  businessName        String
  businessDescription String?
  businessPhone       String?
  businessEmail       String?

  countryId String?
  stateId   String?
  lgaId     String?

  status SellerStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  country Country? @relation(fields: [countryId], references: [id])
  state   State?   @relation(fields: [stateId], references: [id])
  lga     Lga?     @relation(fields: [lgaId], references: [id])

  locations    BusinessLocation[]
  products     Product[]
  variants     ProductVariant[]
  sellerOrders SellerOrder[]
  warehouses   Warehouse[]

  sourcingResponses SourcingResponse[]
  tradeCapabilities SellerTradeCapability[]
  media             Media[]
  marketActivities  MarketActivity[]

  @@index([stateId])
  @@index([lgaId])
  @@index([status])
}

model BusinessLocation {
  id String @id @default(cuid())

  sellerId String

  name        String
  addressLine String

  countryId String
  stateId   String
  lgaId     String
  cityId    String?

  isPrimary             Boolean @default(false)
  isActive              Boolean @default(true)
  isFulfillmentLocation Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  country Country @relation(fields: [countryId], references: [id])
  state   State   @relation(fields: [stateId], references: [id])
  lga     Lga     @relation(fields: [lgaId], references: [id])
  city    City?   @relation(fields: [cityId], references: [id])

  inventory          Inventory[]
  warehouses         Warehouse[]
  reservedOrderItems OrderItem[]

  @@index([sellerId])
  @@index([stateId])
  @@index([lgaId])
  @@index([cityId])
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  type        CategoryType @default(PRODUCT)

  parentId String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products         Product[]
  sourcingRequests SourcingRequest[]
  media            Media[]
  marketActivities MarketActivity[]

  @@index([parentId])
  @@index([isActive])
}

model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products         Product[]
  media            Media[]
  marketActivities MarketActivity[]
}

model Collection {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products         Product[]
  media            Media[]
  marketActivities MarketActivity[]
}

model Product {
  id String @id @default(cuid())

  sellerId String

  name        String
  slug        String
  description String?

  brandId      String?
  categoryId   String
  collectionId String?

  isFeatured   Boolean @default(false)
  isNew        Boolean @default(false)
  isBestSeller Boolean @default(false)

  status ProductStatus @default(DRAFT)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  brand      Brand?      @relation(fields: [brandId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  collection Collection? @relation(fields: [collectionId], references: [id])

  variants  ProductVariant[]
  wishlists Wishlist[]

  sourcingResponses SourcingResponse[]
  media             Media[]
  marketActivities  MarketActivity[]

  @@unique([sellerId, slug])
  @@index([sellerId])
  @@index([categoryId])
  @@index([brandId])
  @@index([collectionId])
  @@index([status])
}

model ProductVariant {
  id String @id @default(cuid())

  productId String
  sellerId  String

  sku String

  name String?

  color String?
  size  String?

  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  weight Decimal @default(0) @db.Decimal(10, 3)

  length Decimal? @db.Decimal(10, 2)
  width  Decimal? @db.Decimal(10, 2)
  height Decimal? @db.Decimal(10, 2)

  fulfillmentType FulfillmentType @default(LOCAL)

  attributes Json?
  metadata   Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller  SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  inventories Inventory[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]

  fulfillmentItems FulfillmentItem[]

  wishlistReferences Wishlist[]

  sourcingResponses SourcingResponse[]
  media             Media[]
  marketActivities  MarketActivity[]

  @@unique([sellerId, sku])
  @@index([productId])
  @@index([sellerId])
  @@index([isActive])
}

// ============================================================
// MEDIA (unified)
// ============================================================

model Media {
  id String @id @default(cuid())

  url          String
  thumbnailUrl String?
  publicId     String?

  mimeType String?
  bytes    Int?
  format   String?
  width    Int?
  height   Int?

  alt String?

  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  // Exactly one owner must be set. Enforced at service + DB level.
  productId         String?
  variantId         String?
  categoryId        String?
  brandId           String?
  collectionId      String?
  reviewId          String?
  sellerId          String?
  sourcingRequestId String?

  createdAt DateTime @default(now())

  product         Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  collection      Collection?      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  review          Review?          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  seller          SellerProfile?   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sourcingRequest SourcingRequest? @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([categoryId])
  @@index([brandId])
  @@index([collectionId])
  @@index([reviewId])
  @@index([sellerId])
  @@index([sourcingRequestId])
}

// ============================================================
// LOCATION-AWARE INVENTORY
// ============================================================

model Inventory {
  id String @id @default(cuid())

  variantId  String
  locationId String

  quantity    Int @default(0)
  reservedQty Int @default(0)

  reorderLevel Int @default(0)

  version Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant  ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  movements  InventoryMovement[]
  orderItems OrderItem[]

  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([locationId])
}

model InventoryMovement {
  id String @id @default(cuid())

  inventoryId String

  type InventoryMovementType

  quantityDelta Int
  reservedDelta Int

  quantityAfter Int
  reservedAfter Int

  reference      String?
  note           String?
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// CART
// ============================================================

model Cart {
  id String @id @default(cuid())

  userId    String?
  sessionId String?

  status CartStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
}

model CartItem {
  id String @id @default(cuid())

  cartId    String
  variantId String

  quantity Int

  unitPriceSnapshot Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ============================================================
// SOURCING / B2B COLLABORATION
// ============================================================

model SourcingRequest {
  id String @id @default(cuid())

  buyerId String

  categoryId String?

  title       String
  description String?

  quantity Int

  targetUnitPrice Decimal? @db.Decimal(12, 2)
  budget          Decimal? @db.Decimal(12, 2)

  requiredBy DateTime?

  countryId String?
  stateId   String?
  lgaId     String?
  cityId    String?

  status SourcingRequestStatus @default(OPEN)

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer User @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  category Category? @relation(fields: [categoryId], references: [id])

  country Country? @relation(fields: [countryId], references: [id])
  state   State?   @relation(fields: [stateId], references: [id])
  lga     Lga?     @relation(fields: [lgaId], references: [id])
  city    City?    @relation(fields: [cityId], references: [id])

  responses SourcingResponse[]
  messages  SourcingMessage[]

  order Order?
  media Media[]

  @@index([buyerId])
  @@index([categoryId])
  @@index([stateId])
  @@index([lgaId])
  @@index([status])
  @@index([createdAt])
}

model SourcingResponse {
  id String @id @default(cuid())

  requestId String
  sellerId  String

  productId String?
  variantId String?

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)

  minimumOrderQuantity Int?

  estimatedDeliveryDays Int?

  fulfillmentType FulfillmentType @default(LOCAL)

  paymentTerm TradePaymentTerm @default(PREPAID)

  shippingMethod ShippingMethod?

  notes String?

  status SourcingResponseStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  seller SellerProfile @relation(fields: [sellerId], references: [id])

  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  messages SourcingMessage[]

  order  Order?
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([requestId])
  @@index([sellerId])
  @@index([productId])
  @@index([variantId])
  @@index([status])
}

model SourcingMessage {
  id String @id @default(cuid())

  requestId  String
  responseId String?

  senderId String

  type SourcingMessageType @default(MESSAGE)

  message String

  proposedQuantity  Int?
  proposedUnitPrice Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  request  SourcingRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  response SourcingResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id])

  @@index([requestId])
  @@index([responseId])
  @@index([senderId])
  @@index([createdAt])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id String @id @default(cuid())

  orderNumber String @unique

  buyerId String?

  type OrderType @default(RETAIL)

  sourcingRequestId  String? @unique
  sourcingResponseId String? @unique

  customerName  String
  customerEmail String?
  customerPhone String?

  deliveryAddress String

  deliveryCountryId String?
  deliveryStateId   String?
  deliveryLgaId     String?
  deliveryCityId    String?

  // Immutable geographic snapshot.
  deliveryCountryName String?
  deliveryStateName   String?
  deliveryLgaName     String?
  deliveryCityName    String?

  subtotal      Decimal @db.Decimal(12, 2)
  shippingTotal Decimal @default(0) @db.Decimal(12, 2)
  tax           Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  paymentTerm TradePaymentTerm @default(PREPAID)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer User? @relation(fields: [buyerId], references: [id], onDelete: SetNull)

  sourcingRequest  SourcingRequest?  @relation(fields: [sourcingRequestId], references: [id])
  sourcingResponse SourcingResponse? @relation(fields: [sourcingResponseId], references: [id])

  deliveryCountry Country? @relation(fields: [deliveryCountryId], references: [id])
  deliveryState   State?   @relation(fields: [deliveryStateId], references: [id])
  deliveryLga     Lga?     @relation(fields: [deliveryLgaId], references: [id])
  deliveryCity    City?    @relation(fields: [deliveryCityId], references: [id])

  sellerOrders SellerOrder[]
  items        OrderItem[]
  payments     Payment[]
  reviews      Review[]

  @@index([buyerId])
  @@index([type])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model SellerOrder {
  id String @id @default(cuid())

  orderId  String
  sellerId String

  subtotal      Decimal @db.Decimal(12, 2)
  shippingTotal Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  paymentTerm TradePaymentTerm @default(PREPAID)

  status SellerOrderStatus @default(PENDING)

  // Immutable seller geography snapshot.
  sellerStateId String?
  sellerLgaId   String?

  sellerStateName String?
  sellerLgaName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller SellerProfile @relation(fields: [sellerId], references: [id])

  items        OrderItem[]
  fulfillments Fulfillment[]

  @@unique([orderId, sellerId])
  @@index([sellerId])
  @@index([status])
}

model OrderItem {
  id String @id @default(cuid())

  orderId       String
  sellerOrderId String?
  variantId     String

  inventoryId        String?
  reservedLocationId String?

  quantity Int

  unitPriceSnapshot Decimal @db.Decimal(12, 2)
  totalPrice        Decimal @db.Decimal(12, 2)

  productName String?
  variantName String?
  sku         String?

  sellerName String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)

  variant ProductVariant @relation(fields: [variantId], references: [id])

  inventory        Inventory?        @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  reservedLocation BusinessLocation? @relation(fields: [reservedLocationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([variantId])
  @@index([inventoryId])
  @@index([reservedLocationId])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id String @id @default(cuid())

  orderId String?

  type     PaymentType     @default(ORDER_PAYMENT)
  provider PaymentProvider @default(PAYSTACK)

  reference         String  @unique
  providerReference String? @unique

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("NGN")

  status PaymentStatus @default(PENDING)

  authorizationUrl String?
  accessCode       String?

  providerPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
}

// ============================================================
// FULFILLMENT
// ============================================================

model Warehouse {
  id String @id @default(cuid())

  sellerId   String?
  locationId String?

  name String
  code String @unique

  type FulfillmentType @default(LOCAL)

  countryId String?
  stateId   String?
  lgaId     String?
  cityId    String?

  address String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller   SellerProfile?    @relation(fields: [sellerId], references: [id])
  location BusinessLocation? @relation(fields: [locationId], references: [id])

  country Country? @relation(fields: [countryId], references: [id])
  state   State?   @relation(fields: [stateId], references: [id])
  lga     Lga?     @relation(fields: [lgaId], references: [id])
  city    City?    @relation(fields: [cityId], references: [id])

  fulfillments Fulfillment[]

  @@index([sellerId])
  @@index([locationId])
  @@index([stateId])
  @@index([lgaId])
}

model Fulfillment {
  id String @id @default(cuid())

  sellerOrderId String
  warehouseId   String?

  type   FulfillmentType
  status FulfillmentStatus @default(PENDING)

  trackingNumber String?
  carrier        String?
  trackingUrl    String?

  shippingMethod ShippingMethod?

  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  shippingCost Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  items FulfillmentItem[]

  @@index([sellerOrderId])
  @@index([warehouseId])
  @@index([status])
}

model FulfillmentItem {
  id String @id @default(cuid())

  fulfillmentId String
  variantId     String

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  fulfillment Fulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([fulfillmentId])
  @@index([variantId])
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id String @id @default(cuid())

  userId    String
  variantId String
  orderId   String?

  rating Int

  title   String?
  comment String?

  status ReviewStatus @default(PENDING)

  isVerified Boolean @default(false)

  helpful    Int @default(0)
  notHelpful Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  variant ProductVariant @relation(fields: [variantId], references: [id])

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  media    Media[]
  response ReviewResponse?

  @@index([userId])
  @@index([variantId])
  @@index([orderId])
  @@index([status])
}

model ReviewResponse {
  id String @id @default(cuid())

  reviewId String @unique
  userId   String

  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id String @id @default(cuid())

  userId    String
  productId String
  variantId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@index([productId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id String @id @default(cuid())

  userId String

  type    String
  title   String
  message String

  data Json?

  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

model NotificationPreference {
  id String @id @default(cuid())

  userId String @unique

  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  userId String?

  action     String
  resource   String?
  resourceId String?

  metadata Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
}

// ============================================================
// BUSINESS CONFIGURATION
// ============================================================

model BusinessConfig {
  id String @id @default(cuid())

  key   String @unique
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// MARKET ACTIVITY (raw behavior events)
// ============================================================

model MarketActivity {
  id String @id @default(cuid())

  activityType MarketActivityType

  userId String?

  productId    String?
  variantId    String?
  sellerId     String?
  categoryId   String?
  brandId      String?
  collectionId String?

  countryId String?
  stateId   String?
  lgaId     String?
  cityId    String?

  quantity Int?

  metadata Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  seller     SellerProfile?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand      Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  collection Collection?     @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  state   State?   @relation(fields: [stateId], references: [id], onDelete: SetNull)
  lga     Lga?     @relation(fields: [lgaId], references: [id], onDelete: SetNull)
  city    City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([activityType, createdAt])
  @@index([userId, createdAt])
  @@index([productId, activityType, createdAt])
  @@index([variantId, activityType, createdAt])
  @@index([sellerId, activityType, createdAt])
  @@index([categoryId, activityType, createdAt])
  @@index([countryId, activityType, createdAt])
  @@index([stateId, activityType, createdAt])
  @@index([lgaId, activityType, createdAt])
  @@index([cityId, activityType, createdAt])
  @@index([createdAt])
}

// ============================================================
// MARKET SIGNALS (aggregated, derived from activity + supply)
// ============================================================

model MarketSignal {
  id String @id @default(cuid())

  signalType MarketSignalType
  entityType MarketSignalEntityType
  entityId   String

  scopeKey String @default("GLOBAL")

  countryId String?
  stateId   String?
  lgaId     String?
  cityId    String?

  windowStart DateTime
  windowEnd   DateTime

  metrics Json
  score   Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  state   State?   @relation(fields: [stateId], references: [id], onDelete: SetNull)
  lga     Lga?     @relation(fields: [lgaId], references: [id], onDelete: SetNull)
  city    City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@unique([signalType, entityType, entityId, scopeKey, windowStart, windowEnd])
  @@index([entityId, scopeKey])
  @@index([windowStart, windowEnd])
  @@index([countryId, signalType])
  @@index([stateId, signalType])
  @@index([lgaId, signalType])
  @@index([cityId, signalType])
}

// ============================================================
// OUTBOX (async event queue, drained by future worker)
// ============================================================

model OutboxEvent {
  id String @id @default(cuid())

  eventType     String
  aggregateType String
  aggregateId   String

  payload Json

  status OutboxEventStatus @default(PENDING)

  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  processedAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@index([eventType, createdAt])
  @@index([aggregateType, aggregateId])
}